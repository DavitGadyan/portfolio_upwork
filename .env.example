# Copy to .env.local for local builds. In GitHub these come from repository variables (see README "Deploying").
# Served at upwork.davidgadyan.com (GitHub Pages custom domain; davitgadyan.github.io/portfolio_upwork forwards there):
NEXT_PUBLIC_SITE_URL=https://upwork.davidgadyan.com
NEXT_PUBLIC_BASE_PATH=
CUSTOM_DOMAIN=upwork.davidgadyan.com
# Set to 1 to fail the build on Spanish pages that look untranslated.
VERIFY_STRICT_ES=
