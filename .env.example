# Copy to .env.local for local builds. In GitHub these come from repository variables (see README "Deploying").
# While served from github.io:
NEXT_PUBLIC_SITE_URL=https://davitgadyan.github.io/portfolio_upwork
NEXT_PUBLIC_BASE_PATH=/portfolio_upwork
CUSTOM_DOMAIN=
# Once davidgadyan.com points at GitHub Pages:
# NEXT_PUBLIC_SITE_URL=https://davidgadyan.com
# NEXT_PUBLIC_BASE_PATH=
# CUSTOM_DOMAIN=davidgadyan.com
# Set to 1 to fail the build on Spanish pages that look untranslated.
VERIFY_STRICT_ES=
