# dependencies
node_modules/

# build output (regenerated by `npm run build`; deployed by .github/workflows/pages.yml)
.next/
out/
tsconfig.tsbuildinfo

# next-image-export-optimizer cache (regenerated at build time from the originals)
**/nextImageExportOptimizer/

# tests
test-results/
playwright-report/
blob-report/
coverage/

# local env (the workflow reads repository variables instead)
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/

# private working notes for Claude Code (never committed)
CLAUDE.md
CLAUDE.local.md

# proposal links with their keys (scripts/proposal-publish.mjs); keys must never reach git
.proposals.local.json
